# ============ BidOx AI 环境配置 ============
# 复制为 .env 后按需修改

# --- 服务 ---
APP_NAME=BidOx AI
APP_ENV=dev
DEBUG=true
API_PREFIX=/api/bidox

# --- PostgreSQL + pgvector ---
DATABASE_URL=postgresql+psycopg://postgres:123456@localhost:5433/bidox_ai
VECTOR_DIM=1024

# --- RabbitMQ ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
QUEUE_PARSE=bidox.document.parse
QUEUE_EMBEDDING=bidox.document.embedding
QUEUE_ANALYSIS=bidox.tender.analysis

# --- MinIO / OSS ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=bidox
MINIO_SECURE=false

# --- Embedding (BGE-M3) ---
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
# 未安装 sentence-transformers 时是否报错(否则降级为 hash stub)
EMBEDDING_REQUIRED=false
# local = FlagEmbedding 进程内加载; ollama = 走 Ollama HTTP API
# EMBEDDING_PROVIDER=local
EMBEDDING_PROVIDER=ollama


# --- Ollama (EMBEDDING_PROVIDER=ollama 时使用) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_TIMEOUT=60

# --- Reranker ---
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TOP_K=5
RERANKER_ENABLED=true
RERANKER_RECALL_K=20

# --- LLM (OpenAI 兼容协议,支持多 provider 切换) ---
# 切换:注释当前 provider,取消注释目标 provider 即可。
# 公共参数(所有 provider 共享)
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=120

# ---- DeepSeek (当前使用) ----
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-pro

# ---- 通义千问 ----
# LLM_PROVIDER=qwen
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=
# LLM_MODEL=qwen3.8-max

# ---- OpenAI ----
#LLM_PROVIDER=openai
#LLM_BASE_URL=https://api.openai.com/v1
#LLM_API_KEY=
#LLM_MODEL=gpt-4o


# --- 切分 ---
CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP=150
CHUNK_MIN_CHARS=80

# --- 检索 ---
RETRIEVAL_TOP_K=10
RETRIEVAL_FUSION_K=60

# --- 企业事实(enterprise_facts 层) ---
ENTERPRISE_FACT_DOCUMENT_TYPES=["enterprise_profile","qualification","project_case"]
ENTERPRISE_FACT_TOP_K=5
